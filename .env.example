# Copy this file to .env for local Docker SQL Server setup.
# Do not commit real .env files.

# SQL Server requires a strong SA password.
LEAVEFLOW_SQL_PASSWORD=Change_this_local_password_123!

# Development demo users are created only when the app runs in Development.
LeaveFlow__Development__DemoPassword=Change_this_demo_password_123!

# Local app connection string used by dotnet run.
ConnectionStrings__DefaultConnection=Server=localhost,1433;Database=LeaveFlow;User Id=sa;Password=${LEAVEFLOW_SQL_PASSWORD};Encrypt=True;TrustServerCertificate=True

# AI stays disabled unless explicitly configured.
AI__Enabled=false
AI__Azure__Endpoint=
AI__Azure__Deployment=
AI__Azure__ApiKey=
