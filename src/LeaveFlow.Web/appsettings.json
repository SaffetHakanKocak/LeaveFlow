{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "LeaveFlow": {
    "Database": {
      "ConnectionStringName": "DefaultConnection"
    },
    "Authentication": {
      "MaxFailedAccessAttempts": 5,
      "LockoutDurationMinutes": 15,
      "MaxPasswordLength": 256,
      "Cookie": {
        "Name": ".LeaveFlow.Auth",
        "ExpireTimeSpanMinutes": 480,
        "SlidingExpiration": true
      }
    }
  },
  "AllowedHosts": "*"
}
