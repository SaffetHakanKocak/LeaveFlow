@using LeaveFlow.Domain.LeaveRequests
@model MyLeaveRequestsViewModel
@{
    ViewData["Title"] = "İzin Taleplerim";
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
    <div>
        <h1 class="h3 mb-1">İzin Taleplerim</h1>
        <p class="text-secondary mb-0">Gönderdiğiniz izin taleplerinin durumunu takip edin.</p>
    </div>
    <a class="btn btn-primary" asp-action="Create">Yeni Talep</a>
</div>

<form method="get" class="lf-panel mb-3">
    <div class="row g-2 align-items-end">
        <div class="col-md-3">
            <label class="form-label" for="status">Durum</label>
            <select class="form-select" id="status" name="status">
                <option value="">Tümü</option>
                <option value="@LeaveRequestStatuses.Pending" selected="@(Model.Status == LeaveRequestStatuses.Pending)">Bekliyor</option>
                <option value="@LeaveRequestStatuses.Approved" selected="@(Model.Status == LeaveRequestStatuses.Approved)">Onaylandı</option>
                <option value="@LeaveRequestStatuses.Rejected" selected="@(Model.Status == LeaveRequestStatuses.Rejected)">Reddedildi</option>
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label" for="fromDate">Başlangıç</label>
            <input class="form-control" id="fromDate" name="fromDate" type="date" value="@Model.FromDate?.ToString("yyyy-MM-dd")" />
        </div>
        <div class="col-md-3">
            <label class="form-label" for="toDate">Bitiş</label>
            <input class="form-control" id="toDate" name="toDate" type="date" value="@Model.ToDate?.ToString("yyyy-MM-dd")" />
        </div>
        <div class="col-md-3">
            <button class="btn btn-outline-primary w-100" type="submit">Filtrele</button>
        </div>
    </div>
</form>

<div class="table-responsive lf-panel">
    <table class="table align-middle mb-0">
        <thead>
            <tr>
                <th>Gerekçe</th>
                <th>Tarih aralığı</th>
                <th>Durum</th>
                <th>Oluşturulma</th>
                <th class="text-end">İşlemler</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var request in Model.Results.Items)
        {
            <tr>
                <td>@request.Reason</td>
                <td>@UiText.Date(request.StartDate) - @UiText.Date(request.EndDate)</td>
                <td><span class="badge @LeaveFlow.Web.Controllers.LeaveRequestsController.StatusBadgeClass(request.Status)">@UiText.Status(request.Status)</span></td>
                <td>@UiText.DateTime(request.CreatedAt)</td>
                <td class="text-end">
                    <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@request.Id">Detay</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>

<partial name="_Pagination" model="Model.Results" />
