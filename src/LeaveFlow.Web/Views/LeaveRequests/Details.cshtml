@model LeaveFlow.Application.LeaveRequests.LeaveRequestDetail
@{
    ViewData["Title"] = "İzin Talebi";
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
    <div>
        <h1 class="h3 mb-1">İzin Talebi</h1>
        <p class="text-secondary mb-0">@UiText.Date(Model.StartDate) - @UiText.Date(Model.EndDate)</p>
    </div>
    <a class="btn btn-outline-secondary" asp-action="Index">Geri</a>
</div>

<div class="lf-panel">
    <dl class="row mb-0">
        <dt class="col-sm-3">Gerekçe</dt>
        <dd class="col-sm-9">@Model.Reason</dd>
        <dt class="col-sm-3">Durum</dt>
        <dd class="col-sm-9"><span class="badge @LeaveFlow.Web.Controllers.LeaveRequestsController.StatusBadgeClass(Model.Status)">@UiText.Status(Model.Status)</span></dd>
        <dt class="col-sm-3">Oluşturulma</dt>
        <dd class="col-sm-9">@UiText.DateTime(Model.CreatedAt)</dd>
        <dt class="col-sm-3">Değerlendirme</dt>
        <dd class="col-sm-9">@UiText.DateTime(Model.ReviewedAt, "Henüz değerlendirilmedi")</dd>
        <dt class="col-sm-3">Değerlendirme notu</dt>
        <dd class="col-sm-9">@(Model.ReviewNote ?? "-")</dd>
    </dl>
</div>
