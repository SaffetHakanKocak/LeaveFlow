@model LeaveFlow.Application.LeaveRequests.LeaveRequestDetail
@{
    ViewData["Title"] = "Leave Request";
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
    <div>
        <h1 class="h3 mb-1">Leave Request</h1>
        <p class="text-secondary mb-0">@Model.StartDate.ToString("yyyy-MM-dd") - @Model.EndDate.ToString("yyyy-MM-dd")</p>
    </div>
    <a class="btn btn-outline-secondary" asp-action="Index">Back</a>
</div>

<div class="lf-panel">
    <dl class="row mb-0">
        <dt class="col-sm-3">Reason</dt>
        <dd class="col-sm-9">@Model.Reason</dd>
        <dt class="col-sm-3">Status</dt>
        <dd class="col-sm-9"><span class="badge @LeaveFlow.Web.Controllers.LeaveRequestsController.StatusBadgeClass(Model.Status)">@Model.Status</span></dd>
        <dt class="col-sm-3">Created</dt>
        <dd class="col-sm-9">@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")</dd>
        <dt class="col-sm-3">Reviewed</dt>
        <dd class="col-sm-9">@(Model.ReviewedAt?.ToString("yyyy-MM-dd HH:mm") ?? "Not reviewed")</dd>
        <dt class="col-sm-3">Review note</dt>
        <dd class="col-sm-9">@(Model.ReviewNote ?? "-")</dd>
    </dl>
</div>
