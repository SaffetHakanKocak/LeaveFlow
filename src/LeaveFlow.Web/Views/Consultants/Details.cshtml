@model LeaveFlow.Application.People.ConsultantDetail
@{
    ViewData["Title"] = "Consultant Details";
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
    <h1 class="h3 mb-0">@Model.FirstName @Model.LastName</h1>
    @if (User.IsInRole("Administrator"))
    {
        <a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@Model.Id">Edit</a>
    }
</div>

<section class="lf-panel">
    <dl class="row mb-0">
        <dt class="col-sm-3">Email</dt>
        <dd class="col-sm-9">@Model.Email</dd>
        <dt class="col-sm-3">Employee #</dt>
        <dd class="col-sm-9">@Model.EmployeeNumber</dd>
        <dt class="col-sm-3">Department</dt>
        <dd class="col-sm-9">@Model.Department</dd>
        <dt class="col-sm-3">Start Date</dt>
        <dd class="col-sm-9">@Model.StartDate?.ToString("yyyy-MM-dd")</dd>
        <dt class="col-sm-3">Status</dt>
        <dd class="col-sm-9">@(Model.IsActive ? "Active" : "Inactive")</dd>
    </dl>
</section>
