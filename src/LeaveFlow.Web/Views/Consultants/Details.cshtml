@model LeaveFlow.Application.People.ConsultantDetail
@{
    ViewData["Title"] = "Danışman Detayı";
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
    <h1 class="h3 mb-0">@Model.FirstName @Model.LastName</h1>
    @if (User.IsInRole("Administrator"))
    {
        <a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@Model.Id">Düzenle</a>
    }
</div>

<section class="lf-panel">
    <dl class="row mb-0">
        <dt class="col-sm-3">E-posta</dt>
        <dd class="col-sm-9">@Model.Email</dd>
        <dt class="col-sm-3">Personel No</dt>
        <dd class="col-sm-9">@Model.EmployeeNumber</dd>
        <dt class="col-sm-3">Departman</dt>
        <dd class="col-sm-9">@Model.Department</dd>
        <dt class="col-sm-3">Başlangıç Tarihi</dt>
        <dd class="col-sm-9">@UiText.Date(Model.StartDate)</dd>
        <dt class="col-sm-3">Durum</dt>
        <dd class="col-sm-9">@UiText.Active(Model.IsActive)</dd>
    </dl>
</section>
