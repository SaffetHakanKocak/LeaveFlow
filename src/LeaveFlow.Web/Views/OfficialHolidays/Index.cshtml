@model OfficialHolidayListViewModel
@{
    ViewData["Title"] = "Resmi Tatiller";
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
    <div>
        <h1 class="h3 mb-1">Resmi Tatiller</h1>
        <p class="text-secondary mb-0">Resmi tatil aralıklarını ve oluşturulan günleri yönetin.</p>
    </div>
    <a class="btn btn-primary" asp-action="Create">Oluştur</a>
</div>

<form method="get" class="lf-panel mb-3">
    <div class="row g-2 align-items-end">
        <div class="col-md-4">
            <label class="form-label" for="search">Ara</label>
            <input class="form-control" id="search" name="search" value="@Model.Search" />
        </div>
        <div class="col-md-3">
            <label class="form-label" for="fromDate">Başlangıç</label>
            <input class="form-control" id="fromDate" name="fromDate" type="date" value="@Model.FromDate?.ToString("yyyy-MM-dd")" />
        </div>
        <div class="col-md-3">
            <label class="form-label" for="toDate">Bitiş</label>
            <input class="form-control" id="toDate" name="toDate" type="date" value="@Model.ToDate?.ToString("yyyy-MM-dd")" />
        </div>
        <div class="col-md-2">
            <button class="btn btn-outline-primary w-100" type="submit">Filtrele</button>
        </div>
    </div>
</form>

<div class="table-responsive lf-panel">
    <table class="table align-middle mb-0">
        <thead>
            <tr>
                <th>Ad</th>
                <th>Tarih aralığı</th>
                <th>Gün</th>
                <th class="text-end">İşlemler</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var holiday in Model.Results.Items)
        {
            <tr>
                <td>@holiday.Name</td>
                <td>@UiText.Date(holiday.StartDate) - @UiText.Date(holiday.EndDate)</td>
                <td>@holiday.DayCount</td>
                <td class="text-end">
                    <div class="lf-action-row">
                        <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@holiday.Id">Detay</a>
                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@holiday.Id">Düzenle</a>
                        <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@holiday.Id">Sil</a>
                    </div>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>

<partial name="_Pagination" model="Model.Results" />
