@model WorkforceTimelineViewModel
@{
    ViewData["Title"] = "İzin Zaman Çizelgesi";
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
    <div>
        <h1 class="h3 mb-1">İzin Zaman Çizelgesi</h1>
        <p class="text-secondary mb-0">Seçili ekip kapsamında onaylı izin görünürlüğü.</p>
    </div>
</div>

<form method="get" class="lf-panel mb-3">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="row g-2 align-items-end">
        <div class="col-md-2">
            <label class="form-label" for="startDate">Başlangıç</label>
            <input class="form-control" id="startDate" name="startDate" type="date" value="@Model.StartDate?.ToString("yyyy-MM-dd")" />
            <span class="text-danger field-validation-valid" data-valmsg-for="StartDate"></span>
        </div>
        <div class="col-md-2">
            <label class="form-label" for="endDate">Bitiş</label>
            <input class="form-control" id="endDate" name="endDate" type="date" value="@Model.EndDate?.ToString("yyyy-MM-dd")" />
            <span class="text-danger field-validation-valid" data-valmsg-for="EndDate"></span>
        </div>
        <div class="col-md-3">
            <label class="form-label" for="consultantSearch">Danışman</label>
            <input class="form-control" id="consultantSearch" name="consultantSearch" value="@Model.ConsultantSearch" />
        </div>
        <div class="col-md-3">
            <label class="form-label" for="managerId">Yönetici filtresi</label>
            <input class="form-control" id="managerId" name="managerId" value="@Model.ManagerId" />
        </div>
        <div class="col-md-2">
            <div class="form-check mb-2">
                <input class="form-check-input" type="checkbox" id="includeInactive" name="includeInactive" value="true" checked="@Model.IncludeInactive" />
                <label class="form-check-label" for="includeInactive">Pasifleri dahil et</label>
            </div>
            <button class="btn btn-outline-primary w-100" type="submit">Uygula</button>
        </div>
    </div>
</form>

@if (Model.Timeline is null)
{
    <div class="lf-panel">
        <div class="lf-empty-state text-secondary">@LeaveFlow.Application.Timeline.WorkforceTimelineSettings.MaxRangeDays güne kadar bir tarih aralığı seçin.</div>
    </div>
}
else if (Model.Timeline.Rows.Count == 0)
{
    <div class="lf-panel">
        <div class="lf-empty-state text-secondary">Bu kapsam ve filtre için danışman bulunamadı.</div>
    </div>
}
else
{
    <div class="lf-panel mb-3">
        <div class="d-flex flex-wrap gap-3 small">
            <span><span class="lf-legend lf-legend-leave"></span> Onaylı izin</span>
            <span><span class="lf-legend lf-legend-weekend"></span> Hafta sonu</span>
            <span><span class="lf-legend lf-legend-today"></span> Bugün</span>
        </div>
    </div>

    <div class="table-responsive lf-panel lf-timeline-wrap">
        <table class="table table-sm align-middle mb-0 lf-timeline">
            <thead>
                <tr>
                    <th class="lf-sticky-col">Danışman</th>
                    @foreach (var day in Model.Timeline.Days)
                    {
                        <th class="text-center @(day.IsWeekend ? "lf-weekend" : string.Empty) @(day.IsToday ? "lf-today" : string.Empty)">
                            <div>@UiText.ShortMonthDay(day.Date)</div>
                            <div class="text-secondary small">@UiText.ShortDay(day.Date)</div>
                        </th>
                    }
                </tr>
            </thead>
            <tbody>
            @foreach (var row in Model.Timeline.Rows)
            {
                <tr>
                    <th class="lf-sticky-col">
                        <div>@row.ConsultantName</div>
                        <div class="text-secondary small">@row.ConsultantEmail</div>
                        @if (!row.ConsultantIsActive)
                        {
                            <span class="badge text-bg-secondary">Pasif</span>
                        }
                    </th>
                    @foreach (var cell in row.Cells)
                    {
                        var title = cell.IsOnLeave
                            ? $"{row.ConsultantName} izinde: {cell.Reason}"
                            : $"{row.ConsultantName}: uygun";
                        <td class="text-center @(cell.IsWeekend ? "lf-weekend" : string.Empty) @(cell.IsToday ? "lf-today" : string.Empty) @(cell.IsOnLeave ? "lf-leave" : string.Empty)" title="@title">
                            <span class="visually-hidden">@title</span>
                            @(cell.IsOnLeave ? "İzin" : string.Empty)
                        </td>
                    }
                </tr>
            }
            </tbody>
        </table>
    </div>

    @if (Model.Timeline.TotalPages > 1)
    {
        <nav class="mt-3" aria-label="Sayfalama">
            <span class="text-secondary">Sayfa @Model.Timeline.PageNumber / @Model.Timeline.TotalPages</span>
        </nav>
    }
}
