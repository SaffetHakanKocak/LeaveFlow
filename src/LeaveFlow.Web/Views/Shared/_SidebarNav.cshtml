@using Microsoft.Extensions.Options
@model string
@inject IOptions<BrandingOptions> BrandingOptions
@{
    var branding = BrandingViewModel.From(BrandingOptions.Value);
    string Active(string controllerName) => string.Equals(Model, controllerName, StringComparison.OrdinalIgnoreCase) ? "active" : string.Empty;
}

<div class="lf-brand">
    <a class="lf-brand-link" asp-controller="Dashboard" asp-action="Index" aria-label="@branding.ProductName paneli">
        @if (branding.HasLogo)
        {
            <img class="lf-brand-logo" src="@branding.LogoUrl" alt="" />
        }
        else
        {
            <span class="lf-brand-mark" aria-hidden="true">@branding.BrandMarkText</span>
        }
        <span class="lf-brand-copy">
            <span class="lf-brand-name">@branding.ProductName</span>
            <span class="lf-brand-subtitle">@branding.OrganizationName</span>
        </span>
    </a>
</div>

<nav class="lf-nav">
    <a class="lf-nav-link @Active("Dashboard")" asp-controller="Dashboard" asp-action="Index">
        <span>Panel</span>
    </a>
    @if (User.IsInRole("Administrator"))
    {
        <a class="lf-nav-link @Active("Consultants")" asp-controller="Consultants" asp-action="Index">
            <span>Danışmanlar</span>
        </a>
        <a class="lf-nav-link @Active("Managers")" asp-controller="Managers" asp-action="Index">
            <span>Yöneticiler</span>
        </a>
    }
    @if (User.IsInRole("Consultant"))
    {
        <a class="lf-nav-link @Active("LeaveRequests")" asp-controller="LeaveRequests" asp-action="Index">
            <span>İzin Taleplerim</span>
        </a>
    }
    @if (User.IsInRole("Manager") || User.IsInRole("Administrator"))
    {
        <a class="lf-nav-link @Active("LeaveReviews")" asp-controller="LeaveReviews" asp-action="Index">
            <span>İzin Onayları</span>
        </a>
        <a class="lf-nav-link @Active("WorkforceTimeline")" asp-controller="WorkforceTimeline" asp-action="Index">
            <span>İzin Zaman Çizelgesi</span>
        </a>
    }
    <a class="lf-nav-link @Active("OrganizationCalendar")" asp-controller="OrganizationCalendar" asp-action="Index">
        <span>Takvim</span>
    </a>
    <a class="lf-nav-link @Active("AiAssistant")" asp-controller="AiAssistant" asp-action="Index">
        <span>AI Asistan</span>
    </a>
    @if (User.IsInRole("Manager") || User.IsInRole("Administrator"))
    {
        <a class="lf-nav-link @Active("Reports")" asp-controller="Reports" asp-action="Index">
            <span>Raporlar</span>
        </a>
    }
    @if (User.IsInRole("Administrator"))
    {
        <div class="lf-nav-section">Yönetim</div>
        <a class="lf-nav-link @Active("OrganizationHolidays")" asp-controller="OrganizationHolidays" asp-action="Index">
            <span>Kurum Tatilleri</span>
        </a>
        <a class="lf-nav-link @Active("OfficialHolidays")" asp-controller="OfficialHolidays" asp-action="Index">
            <span>Resmi Tatiller</span>
        </a>
    }
</nav>
