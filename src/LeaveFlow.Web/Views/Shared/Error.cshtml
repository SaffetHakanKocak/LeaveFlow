@model ErrorViewModel
@{
    ViewData["Title"] = "Hata";
}

<h1 class="h3 text-danger">İstek tamamlanamadı.</h1>
<p class="text-secondary">İstek işlenirken beklenmeyen bir hata oluştu.</p>

@if (Model.ShowRequestId)
{
    <p>
        <strong>İstek ID:</strong> <code>@Model.RequestId</code>
    </p>
}
