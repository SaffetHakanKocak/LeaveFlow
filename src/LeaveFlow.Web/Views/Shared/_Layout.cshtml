@using Microsoft.Extensions.Options
@inject IOptions<BrandingOptions> BrandingOptions
@{
    var branding = BrandingViewModel.From(BrandingOptions.Value);
    var title = ViewData["Title"]?.ToString() ?? branding.ProductName;
    var brandStyle = branding.HasCustomPrimaryBrandColor
        ? $"--lf-primary: {branding.PrimaryBrandColor}; --lf-primary-strong: {branding.PrimaryBrandColor};"
        : null;
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var primaryRole = User.IsInRole("Administrator")
        ? "Yönetici"
        : User.IsInRole("Manager")
            ? "Yönetici"
            : User.IsInRole("Consultant")
                ? "Danışman"
                : "Kullanıcı";
    var userInitial = string.IsNullOrWhiteSpace(User.Identity?.Name)
        ? "U"
        : User.Identity.Name[0].ToString().ToUpperInvariant();
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@title - @branding.ProductName</title>
    <script>
        (function () {
            var savedTheme = localStorage.getItem("leaveflow-theme");
            var systemTheme = window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
            document.documentElement.setAttribute("data-bs-theme", savedTheme || systemTheme);
        })();
    </script>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/LeaveFlow.Web.styles.css" asp-append-version="true" />
</head>
<body style="@brandStyle">
    @if (isAuthenticated)
    {
        <div class="lf-shell">
            <aside class="lf-sidebar d-none d-lg-flex" aria-label="Ana gezinme">
                <partial name="_SidebarNav" model="controller" />
            </aside>

            <div class="lf-app">
                <header class="lf-topbar">
                    <div class="d-flex align-items-center gap-2">
                        <button class="btn btn-icon d-lg-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#lfMobileNav" aria-controls="lfMobileNav" aria-label="Menüyü aç">
                            <span aria-hidden="true">M</span>
                        </button>
                        <div>
                            <h1 class="lf-page-title mb-0">@title</h1>
                        </div>
                    </div>
                    <div class="lf-topbar-actions">
                        <button class="btn btn-icon" type="button" data-lf-theme-toggle aria-label="Temayı değiştir" title="Temayı değiştir">
                            <span data-lf-theme-icon aria-hidden="true"></span>
                        </button>
                        <div class="lf-user-chip">
                            <span class="lf-user-avatar" aria-hidden="true">@userInitial</span>
                            <span class="lf-user-meta">
                                <span class="lf-user-name">@User.Identity?.Name</span>
                                <span class="lf-role-pill">@primaryRole</span>
                            </span>
                        </div>
                        <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                            <button type="submit" class="btn btn-outline-secondary btn-sm">Çıkış yap</button>
                        </form>
                    </div>
                </header>

                <main role="main" class="lf-main">
                    @RenderBody()
                </main>
                @if (!string.IsNullOrWhiteSpace(branding.FooterText) || !string.IsNullOrWhiteSpace(branding.SupportEmail))
                {
                    <footer class="lf-footer">
                        @if (!string.IsNullOrWhiteSpace(branding.FooterText))
                        {
                            <span>@branding.FooterText</span>
                        }
                        @if (!string.IsNullOrWhiteSpace(branding.SupportEmail))
                        {
                            <a href="mailto:@branding.SupportEmail">@branding.SupportEmail</a>
                        }
                    </footer>
                }
            </div>
        </div>

        <div class="offcanvas offcanvas-start lf-mobile-nav" tabindex="-1" id="lfMobileNav" aria-labelledby="lfMobileNavLabel">
            <div class="offcanvas-header">
                <h2 class="offcanvas-title h5" id="lfMobileNavLabel">
                    <span class="lf-mobile-brand">
                        @if (branding.HasLogo)
                        {
                            <img class="lf-brand-logo" src="@branding.LogoUrl" alt="" />
                        }
                        else
                        {
                            <span class="lf-brand-mark" aria-hidden="true">@branding.BrandMarkText</span>
                        }
                        <span>@branding.ProductName</span>
                    </span>
                </h2>
                <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Menüyü kapat"></button>
            </div>
            <div class="offcanvas-body">
                <partial name="_SidebarNav" model="controller" />
            </div>
        </div>
    }
    else
    {
        <header class="lf-public-topbar">
            <a class="lf-brand-link" asp-controller="Home" asp-action="Index" aria-label="@branding.ProductName">
                @if (branding.HasLogo)
                {
                    <img class="lf-brand-logo" src="@branding.LogoUrl" alt="" />
                }
                else
                {
                    <span class="lf-brand-mark" aria-hidden="true">@branding.BrandMarkText</span>
                }
                <span class="lf-brand-copy">
                    <span class="lf-brand-name">@branding.ProductName</span>
                </span>
            </a>
            <div class="lf-public-actions">
                <button class="btn btn-icon" type="button" data-lf-theme-toggle aria-label="Temayı değiştir" title="Temayı değiştir">
                    <span data-lf-theme-icon aria-hidden="true"></span>
                </button>
                <a class="btn btn-primary btn-sm px-3" asp-controller="Account" asp-action="Login">Giriş yap</a>
            </div>
        </header>
        <main role="main" class="lf-public-main">
            @RenderBody()
        </main>
        @if (!string.IsNullOrWhiteSpace(branding.FooterText) || !string.IsNullOrWhiteSpace(branding.SupportEmail))
        {
            <footer class="lf-footer lf-public-footer">
                @if (!string.IsNullOrWhiteSpace(branding.FooterText))
                {
                    <span>@branding.FooterText</span>
                }
                @if (!string.IsNullOrWhiteSpace(branding.SupportEmail))
                {
                    <a href="mailto:@branding.SupportEmail">@branding.SupportEmail</a>
                }
            </footer>
        }
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
