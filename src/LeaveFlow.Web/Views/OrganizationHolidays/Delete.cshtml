@model LeaveFlow.Application.Holidays.OrganizationHolidayDetail
@{
    ViewData["Title"] = "Kurum Tatilini Sil";
}

<h1 class="h3 mb-3">Kurum Tatilini Sil</h1>

<div class="lf-panel">
    <p><strong>@Model.Name</strong> tatili @UiText.Date(Model.StartDate) - @UiText.Date(Model.EndDate) aralığı için silinsin mi?</p>
    <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-flex gap-2">
        <button type="submit" class="btn btn-danger">Sil</button>
        <a class="btn btn-outline-secondary" asp-action="Index">İptal</a>
    </form>
</div>
