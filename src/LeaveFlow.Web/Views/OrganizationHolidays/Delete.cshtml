@model LeaveFlow.Application.Holidays.OrganizationHolidayDetail
@{
    ViewData["Title"] = "Delete Organization Holiday";
}

<h1 class="h3 mb-3">Delete Organization Holiday</h1>

<div class="lf-panel">
    <p>Delete <strong>@Model.Name</strong> for @Model.StartDate.ToString("yyyy-MM-dd") - @Model.EndDate.ToString("yyyy-MM-dd")?</p>
    <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-flex gap-2">
        <button type="submit" class="btn btn-danger">Delete</button>
        <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
    </form>
</div>
