@model OrganizationHolidayListViewModel
@{
    ViewData["Title"] = "Organization Holidays";
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
    <div>
        <h1 class="h3 mb-1">Organization Holidays</h1>
        <p class="text-secondary mb-0">Manage internal holiday ranges and generated day rows.</p>
    </div>
    <a class="btn btn-primary" asp-action="Create">Create</a>
</div>

<form method="get" class="lf-panel mb-3">
    <div class="row g-2 align-items-end">
        <div class="col-md-3">
            <label class="form-label" for="search">Search</label>
            <input class="form-control" id="search" name="search" value="@Model.Search" />
        </div>
        <div class="col-md-2">
            <label class="form-label" for="isActive">Status</label>
            <select class="form-select" id="isActive" name="isActive">
                <option value="">All</option>
                <option value="true" selected="@(Model.IsActive == true)">Active</option>
                <option value="false" selected="@(Model.IsActive == false)">Inactive</option>
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label" for="fromDate">From</label>
            <input class="form-control" id="fromDate" name="fromDate" type="date" value="@Model.FromDate?.ToString("yyyy-MM-dd")" />
        </div>
        <div class="col-md-2">
            <label class="form-label" for="toDate">To</label>
            <input class="form-control" id="toDate" name="toDate" type="date" value="@Model.ToDate?.ToString("yyyy-MM-dd")" />
        </div>
        <div class="col-md-3">
            <button class="btn btn-outline-primary w-100" type="submit">Filter</button>
        </div>
    </div>
</form>

<div class="table-responsive lf-panel">
    <table class="table align-middle mb-0">
        <thead>
            <tr>
                <th>Name</th>
                <th>Date range</th>
                <th>Days</th>
                <th>Status</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var holiday in Model.Results.Items)
        {
            <tr>
                <td>@holiday.Name</td>
                <td>@holiday.StartDate.ToString("yyyy-MM-dd") - @holiday.EndDate.ToString("yyyy-MM-dd")</td>
                <td>@holiday.DayCount</td>
                <td>@(holiday.IsActive ? "Active" : "Inactive")</td>
                <td class="text-end">
                    <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@holiday.Id">Details</a>
                    <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@holiday.Id">Edit</a>
                    <form asp-action="SetActive" asp-route-id="@holiday.Id" method="post" class="d-inline">
                        <input type="hidden" name="isActive" value="@(!holiday.IsActive)" />
                        <button class="btn btn-sm btn-outline-warning" type="submit">@(holiday.IsActive ? "Deactivate" : "Activate")</button>
                    </form>
                    <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@holiday.Id">Delete</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>

<partial name="_Pagination" model="Model.Results" />
