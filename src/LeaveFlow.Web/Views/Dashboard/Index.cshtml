@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
    <div>
        <h1 class="h3 mb-1">@Model.Dashboard.Scope Dashboard</h1>
        <p class="text-secondary mb-0">Operational leave and holiday overview for your authorized scope.</p>
    </div>
    @if (User.IsInRole("Manager") || User.IsInRole("Administrator"))
    {
        <a class="btn btn-outline-primary" asp-controller="Reports" asp-action="Index">Reports</a>
    }
</div>

<section class="lf-dashboard-metrics mb-3">
    @foreach (var metric in Model.Dashboard.Metrics)
    {
        <article class="lf-metric-card">
            <span class="lf-nav-icon mb-3" aria-hidden="true">@metric.Label[0]</span>
            <span>@metric.Label</span>
            <strong>@metric.Value</strong>
        </article>
    }
</section>

<div class="row g-3">
    <section class="col-lg-6">
        <div class="lf-panel h-100">
            <h2 class="h5 mb-3">Upcoming Leaves</h2>
            @if (Model.Dashboard.UpcomingLeaves.Count == 0)
            {
                <div class="lf-empty-state text-secondary">No upcoming approved leaves.</div>
            }
            else
            {
                <div class="list-group list-group-flush">
                    @foreach (var leave in Model.Dashboard.UpcomingLeaves)
                    {
                        <div class="list-group-item px-0">
                            <div class="fw-semibold">@(leave.ConsultantName ?? "My leave")</div>
                            <div class="text-secondary small">@leave.StartDate.ToString("yyyy-MM-dd") - @leave.EndDate.ToString("yyyy-MM-dd") · @leave.DayCount day(s)</div>
                        </div>
                    }
                </div>
            }
        </div>
    </section>
    <section class="col-lg-6">
        <div class="lf-panel h-100">
            <h2 class="h5 mb-3">Upcoming Holidays</h2>
            @if (Model.Dashboard.UpcomingHolidays.Count == 0)
            {
                <div class="lf-empty-state text-secondary">No upcoming holidays.</div>
            }
            else
            {
                <div class="list-group list-group-flush">
                    @foreach (var holiday in Model.Dashboard.UpcomingHolidays)
                    {
                        <div class="list-group-item px-0">
                            <div class="fw-semibold">@holiday.Name</div>
                            <div class="text-secondary small">@holiday.EventType · @holiday.StartDate.ToString("yyyy-MM-dd") - @holiday.EndDate.ToString("yyyy-MM-dd")</div>
                        </div>
                    }
                </div>
            }
        </div>
    </section>
</div>

@if (Model.Dashboard.RecentLeaveRequests.Count > 0)
{
    <section class="lf-panel mt-3">
        <h2 class="h5 mb-3">Recent Leave Requests</h2>
        <div class="table-responsive">
            <table class="table table-sm align-middle mb-0">
                <thead>
                    <tr>
                        <th>Status</th>
                        <th>Start</th>
                        <th>End</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var request in Model.Dashboard.RecentLeaveRequests)
                {
                    <tr>
                        <td><span class="badge @LeaveFlow.Web.Controllers.LeaveRequestsController.StatusBadgeClass(request.Status)">@request.Status</span></td>
                        <td>@request.StartDate.ToString("yyyy-MM-dd")</td>
                        <td>@request.EndDate.ToString("yyyy-MM-dd")</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </section>
}
