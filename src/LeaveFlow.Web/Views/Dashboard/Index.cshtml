@using Microsoft.Extensions.Options
@model DashboardViewModel
@inject IOptions<BrandingOptions> BrandingOptions
@{
    var branding = BrandingViewModel.From(BrandingOptions.Value);
    ViewData["Title"] = "Panel";
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
    <div>
        <h1 class="h3 mb-1">@UiText.Scope(Model.Dashboard.Scope) Paneli</h1>
        <p class="text-secondary mb-0">@branding.OrganizationName kapsamı için izin ve tatil özeti.</p>
    </div>
    @if (User.IsInRole("Manager") || User.IsInRole("Administrator"))
    {
        <a class="btn btn-outline-primary" asp-controller="Reports" asp-action="Index">Raporlar</a>
    }
</div>

<section class="lf-dashboard-metrics mb-3">
    @foreach (var metric in Model.Dashboard.Metrics)
    {
        <article class="lf-metric-card">
            <span>@metric.Label</span>
            <strong>@metric.Value</strong>
        </article>
    }
</section>

<div class="row g-3">
    <section class="col-lg-6">
        <div class="lf-panel h-100">
            <h2 class="h5 mb-3">Yaklaşan İzinler</h2>
            @if (Model.Dashboard.UpcomingLeaves.Count == 0)
            {
                <div class="lf-empty-state text-secondary">Yaklaşan onaylı izin yok.</div>
            }
            else
            {
                <div class="list-group list-group-flush">
                    @foreach (var leave in Model.Dashboard.UpcomingLeaves)
                    {
                        <div class="list-group-item px-0">
                            <div class="fw-semibold">@(leave.ConsultantName ?? "İznim")</div>
                            <div class="text-secondary small">@UiText.Date(leave.StartDate) - @UiText.Date(leave.EndDate) - @leave.DayCount gün</div>
                        </div>
                    }
                </div>
            }
        </div>
    </section>
    <section class="col-lg-6">
        <div class="lf-panel h-100">
            <h2 class="h5 mb-3">Yaklaşan Tatiller</h2>
            @if (Model.Dashboard.UpcomingHolidays.Count == 0)
            {
                <div class="lf-empty-state text-secondary">Yaklaşan tatil yok.</div>
            }
            else
            {
                <div class="list-group list-group-flush">
                    @foreach (var holiday in Model.Dashboard.UpcomingHolidays)
                    {
                        <div class="list-group-item px-0">
                            <div class="fw-semibold">@holiday.Name</div>
                            <div class="text-secondary small">@UiText.EventType(holiday.EventType) - @UiText.Date(holiday.StartDate) - @UiText.Date(holiday.EndDate)</div>
                        </div>
                    }
                </div>
            }
        </div>
    </section>
</div>

@if (Model.Dashboard.RecentLeaveRequests.Count > 0)
{
    <section class="lf-panel mt-3">
        <h2 class="h5 mb-3">Son İzin Talepleri</h2>
        <div class="table-responsive">
            <table class="table table-sm align-middle mb-0">
                <thead>
                    <tr>
                        <th>Durum</th>
                        <th>Başlangıç</th>
                        <th>Bitiş</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var request in Model.Dashboard.RecentLeaveRequests)
                {
                    <tr>
                        <td><span class="badge @LeaveFlow.Web.Controllers.LeaveRequestsController.StatusBadgeClass(request.Status)">@UiText.Status(request.Status)</span></td>
                        <td>@UiText.Date(request.StartDate)</td>
                        <td>@UiText.Date(request.EndDate)</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </section>
}
