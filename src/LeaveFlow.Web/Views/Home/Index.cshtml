@{
    ViewData["Title"] = "Home";
}

<section class="lf-home">
    <div class="lf-home-hero">
        <span class="lf-login-mark" aria-hidden="true">LF</span>
        <h1 class="display-6 fw-semibold mb-2">LeaveFlow</h1>
        <p class="lead text-secondary mb-0">
            Workforce leave, approval, calendar, and reporting management in one focused workspace.
        </p>
    </div>

    <div class="lf-home-grid">
        <div>
            <section class="lf-panel">
                <h2 class="h5">Consultants</h2>
                <p class="mb-0 text-secondary">Submit requests and track leave status.</p>
            </section>
        </div>
        <div>
            <section class="lf-panel">
                <h2 class="h5">Managers</h2>
                <p class="mb-0 text-secondary">Review requests and plan team availability.</p>
            </section>
        </div>
        <div>
            <section class="lf-panel">
                <h2 class="h5">Administrators</h2>
                <p class="mb-0 text-secondary">Manage people, holidays, calendars, and reports.</p>
            </section>
        </div>
    </div>
</section>
