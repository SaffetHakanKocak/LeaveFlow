@using Microsoft.Extensions.Options
@inject IOptions<BrandingOptions> BrandingOptions
@{
    var branding = BrandingViewModel.From(BrandingOptions.Value);
    ViewData["Title"] = "Ana sayfa";
}

<section class="lf-home">
    <div class="lf-home-hero">
        @if (branding.HasLogo)
        {
            <img class="lf-login-logo" src="@branding.LogoUrl" alt="" />
        }
        else
        {
            <span class="lf-login-mark" aria-hidden="true">@branding.BrandMarkText</span>
        }
        <h1 class="display-6 fw-semibold mb-2">@branding.ProductName</h1>
        <p class="lead text-secondary mb-0">
            İzin talepleri, onaylar, takvim ve raporlar tek odaklı çalışma alanında.
        </p>
    </div>

    <div class="lf-home-grid">
        <div>
            <section class="lf-panel">
                <h2 class="h5">Danışmanlar</h2>
                <p class="mb-0 text-secondary">İzin taleplerinizi oluşturun ve durumunu takip edin.</p>
            </section>
        </div>
        <div>
            <section class="lf-panel">
                <h2 class="h5">Yöneticiler</h2>
                <p class="mb-0 text-secondary">Talepleri değerlendirin ve ekip uygunluğunu planlayın.</p>
            </section>
        </div>
        <div>
            <section class="lf-panel">
                <h2 class="h5">Sistem Yöneticileri</h2>
                <p class="mb-0 text-secondary">Kişileri, tatilleri, takvimleri ve raporları yönetin.</p>
            </section>
        </div>
    </div>
</section>
