@using LeaveFlow.Application.Calendar
@model OrganizationCalendarDetailViewModel
@{
    ViewData["Title"] = "Calendar Event";
}

<div class="d-flex align-items-center justify-content-between gap-2 mb-3">
    <div>
        <h1 class="h3 mb-1">@Model.Event.Title</h1>
        <p class="text-secondary mb-0">@EventTypeLabel(Model.Event.EventType)</p>
    </div>
    <a class="btn btn-outline-secondary" href="@Model.ReturnUrl">Back</a>
</div>

<section class="lf-panel">
    <dl class="row mb-0">
        <dt class="col-sm-3">Date range</dt>
        <dd class="col-sm-9">
            @if (Model.Event.StartDate == Model.Event.EndDate)
            {
                @Model.Event.StartDate.ToString("yyyy-MM-dd")
            }
            else
            {
                @($"{Model.Event.StartDate:yyyy-MM-dd} - {Model.Event.EndDate:yyyy-MM-dd}")
            }
        </dd>

        @if (!string.IsNullOrWhiteSpace(Model.Event.ConsultantName))
        {
            <dt class="col-sm-3">Consultant</dt>
            <dd class="col-sm-9">@Model.Event.ConsultantName</dd>
        }

        @if (!string.IsNullOrWhiteSpace(Model.Event.Summary))
        {
            <dt class="col-sm-3">Summary</dt>
            <dd class="col-sm-9">@Model.Event.Summary</dd>
        }
    </dl>
</section>

@functions {
    private static string EventTypeLabel(string eventType)
    {
        return eventType switch
        {
            CalendarEventTypes.Leave => "Leave",
            CalendarEventTypes.OrganizationHoliday => "Organization Holiday",
            CalendarEventTypes.OfficialHoliday => "Official Holiday",
            _ => "Event"
        };
    }
}
