@model ReportsViewModel
@{
    ViewData["Title"] = "Reports";
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
    <div>
        <h1 class="h3 mb-1">Reports</h1>
        <p class="text-secondary mb-0">Leave usage, activity, peaks, and upcoming schedule for your authorized scope.</p>
    </div>
    <a class="btn btn-outline-secondary" asp-controller="Dashboard" asp-action="Index">Dashboard</a>
</div>

<form method="get" class="lf-panel mb-3">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="row g-2 align-items-end">
        <div class="col-md-3">
            <label class="form-label" for="startDate">Start</label>
            <input class="form-control" id="startDate" name="startDate" type="date" value="@Model.StartDate?.ToString("yyyy-MM-dd")" />
        </div>
        <div class="col-md-3">
            <label class="form-label" for="endDate">End</label>
            <input class="form-control" id="endDate" name="endDate" type="date" value="@Model.EndDate?.ToString("yyyy-MM-dd")" />
        </div>
        <div class="col-md-3">
            <label class="form-label" for="managerId">Manager filter</label>
            <input class="form-control" id="managerId" name="managerId" value="@Model.ManagerId" />
        </div>
        <div class="col-md-3">
            <label class="form-label" for="consultantId">Consultant filter</label>
            <input class="form-control" id="consultantId" name="consultantId" value="@Model.ConsultantId" />
        </div>
        <div class="col-md-2">
            <button class="btn btn-outline-primary w-100" type="submit">Apply</button>
        </div>
    </div>
</form>

@if (Model.Reports is null)
{
    <section class="lf-panel">
        <p class="text-secondary mb-0">Choose a report range up to @LeaveFlow.Application.Reporting.ReportingSettings.MaxRangeDays days.</p>
    </section>
}
else
{
    <section class="lf-dashboard-metrics mb-3">
        @foreach (var metric in Model.Reports.SummaryMetrics)
        {
            <article class="lf-metric-card">
                <span class="lf-nav-icon mb-3" aria-hidden="true">@metric.Label[0]</span>
                <span>@metric.Label</span>
                <strong>@metric.Value</strong>
            </article>
        }
    </section>

    <div class="row g-3">
        <section class="col-lg-6">
            <div class="lf-panel h-100">
                <h2 class="h5 mb-3">Consultant Leave Usage</h2>
                @if (Model.Reports.ConsultantLeaveUsage.Count == 0)
                {
                    <div class="lf-empty-state text-secondary">No data for this range.</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0">
                            <tbody>
                            @foreach (var row in Model.Reports.ConsultantLeaveUsage)
                            {
                                <tr>
                                    <td>@row.ConsultantName</td>
                                    <td class="text-end fw-semibold">@row.ApprovedLeaveDayCount day(s)</td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </section>
        <section class="col-lg-6">
            <div class="lf-panel h-100">
                <h2 class="h5 mb-3">Team Leave Usage</h2>
                @if (Model.Reports.TeamLeaveUsage.Count == 0)
                {
                    <div class="lf-empty-state text-secondary">No data for this range.</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0">
                            <tbody>
                            @foreach (var row in Model.Reports.TeamLeaveUsage)
                            {
                                <tr>
                                    <td>@row.ManagerName</td>
                                    <td class="text-end fw-semibold">@row.ApprovedLeaveDayCount day(s), @row.ConsultantCount consultant(s)</td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </section>
        <section class="col-lg-6">
            <div class="lf-panel h-100">
                <h2 class="h5 mb-3">Monthly Leave Activity</h2>
                @if (Model.Reports.MonthlyLeaveActivity.Count == 0)
                {
                    <div class="lf-empty-state text-secondary">No data for this range.</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0">
                            <tbody>
                            @foreach (var row in Model.Reports.MonthlyLeaveActivity)
                            {
                                <tr>
                                    <td>@row.Year-@row.Month.ToString("00")</td>
                                    <td class="text-end fw-semibold">@row.ApprovedLeaveDayCount day(s), @row.RequestCount request(s)</td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </section>
        <section class="col-lg-6">
            <div class="lf-panel h-100">
                <h2 class="h5 mb-3">Peak Leave Days</h2>
                @if (Model.Reports.PeakLeaveDays.Count == 0)
                {
                    <div class="lf-empty-state text-secondary">No data for this range.</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0">
                            <tbody>
                            @foreach (var row in Model.Reports.PeakLeaveDays)
                            {
                                <tr>
                                    <td>@row.LeaveDate.ToString("yyyy-MM-dd")</td>
                                    <td class="text-end fw-semibold">@row.ConsultantCount consultant(s)</td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </section>
        <section class="col-lg-6">
            <div class="lf-panel h-100">
                <h2 class="h5 mb-3">Status Distribution</h2>
                @if (Model.Reports.StatusDistribution.Count == 0)
                {
                    <div class="lf-empty-state text-secondary">No data for this range.</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0">
                            <tbody>
                            @foreach (var row in Model.Reports.StatusDistribution)
                            {
                                <tr>
                                    <td><span class="badge @LeaveFlow.Web.Controllers.LeaveRequestsController.StatusBadgeClass(row.Status)">@row.Status</span></td>
                                    <td class="text-end fw-semibold">@row.RequestCount</td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </section>
        <section class="col-lg-6">
            <div class="lf-panel h-100">
                <h2 class="h5 mb-3">Upcoming Leaves</h2>
                @if (Model.Reports.UpcomingLeaves.Count == 0)
                {
                    <div class="lf-empty-state text-secondary">No data for this range.</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0">
                            <tbody>
                            @foreach (var row in Model.Reports.UpcomingLeaves)
                            {
                                <tr>
                                    <td>@(row.ConsultantName ?? "My leave")</td>
                                    <td class="text-end fw-semibold">@row.StartDate.ToString("yyyy-MM-dd") - @row.EndDate.ToString("yyyy-MM-dd")</td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </section>
        <section class="col-12">
            <div class="lf-panel h-100">
                <h2 class="h5 mb-3">Upcoming Holidays</h2>
                @if (Model.Reports.UpcomingHolidays.Count == 0)
                {
                    <div class="lf-empty-state text-secondary">No data for this range.</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0">
                            <tbody>
                            @foreach (var row in Model.Reports.UpcomingHolidays)
                            {
                                <tr>
                                    <td>@row.Name <span class="text-secondary">(@row.EventType)</span></td>
                                    <td class="text-end fw-semibold">@row.StartDate.ToString("yyyy-MM-dd") - @row.EndDate.ToString("yyyy-MM-dd")</td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </section>
    </div>
}
