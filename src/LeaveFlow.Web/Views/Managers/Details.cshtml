@model LeaveFlow.Application.People.ManagerDetail
@{
    ViewData["Title"] = "Manager Details";
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
    <h1 class="h3 mb-0">@Model.FirstName @Model.LastName</h1>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-success" asp-action="Assignments" asp-route-id="@Model.Id">Assignments</a>
        <a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@Model.Id">Edit</a>
    </div>
</div>

<section class="lf-panel">
    <dl class="row mb-0">
        <dt class="col-sm-3">Email</dt>
        <dd class="col-sm-9">@Model.Email</dd>
        <dt class="col-sm-3">Department</dt>
        <dd class="col-sm-9">@Model.Department</dd>
        <dt class="col-sm-3">Status</dt>
        <dd class="col-sm-9">@(Model.IsActive ? "Active" : "Inactive")</dd>
    </dl>
</section>
