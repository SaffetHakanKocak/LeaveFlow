@using LeaveFlow.Domain.LeaveRequests
@model PendingLeaveRequestsViewModel
@{
    ViewData["Title"] = "Pending Leave Requests";
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
    <div>
        <h1 class="h3 mb-1">Pending Leave Requests</h1>
        <p class="text-secondary mb-0">Review requests in your approval scope.</p>
    </div>
</div>

<form method="get" class="lf-panel mb-3">
    <div class="row g-2 align-items-end">
        <div class="col-md-3">
            <label class="form-label" for="status">Status</label>
            <select class="form-select" id="status" name="status">
                <option value="@LeaveRequestStatuses.Pending" selected="@(Model.Status is null || Model.Status == LeaveRequestStatuses.Pending)">Pending</option>
                <option value="@LeaveRequestStatuses.Approved" selected="@(Model.Status == LeaveRequestStatuses.Approved)">Approved</option>
                <option value="@LeaveRequestStatuses.Rejected" selected="@(Model.Status == LeaveRequestStatuses.Rejected)">Rejected</option>
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label" for="fromDate">From</label>
            <input class="form-control" id="fromDate" name="fromDate" type="date" value="@Model.FromDate?.ToString("yyyy-MM-dd")" />
        </div>
        <div class="col-md-3">
            <label class="form-label" for="toDate">To</label>
            <input class="form-control" id="toDate" name="toDate" type="date" value="@Model.ToDate?.ToString("yyyy-MM-dd")" />
        </div>
        <div class="col-md-3">
            <button class="btn btn-outline-primary w-100" type="submit">Filter</button>
        </div>
    </div>
</form>

<div class="table-responsive lf-panel">
    <table class="table align-middle mb-0">
        <thead>
            <tr>
                <th>Consultant</th>
                <th>Reason</th>
                <th>Date range</th>
                <th>Status</th>
                <th>Created</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var request in Model.Results.Items)
        {
            <tr>
                <td>
                    <div>@request.ConsultantName</div>
                    <div class="text-secondary small">@request.ConsultantEmail</div>
                </td>
                <td>@request.Reason</td>
                <td>@request.StartDate.ToString("yyyy-MM-dd") - @request.EndDate.ToString("yyyy-MM-dd")</td>
                <td><span class="badge @LeaveFlow.Web.Controllers.LeaveRequestsController.StatusBadgeClass(request.Status)">@request.Status</span></td>
                <td>@request.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                <td class="text-end">
                    <a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@request.Id">Review</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>

<partial name="_Pagination" model="Model.Results" />
