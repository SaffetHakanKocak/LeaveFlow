@using LeaveFlow.Domain.LeaveRequests
@model LeaveReviewDetailViewModel
@{
    ViewData["Title"] = "İzin Onayı";
    var isPending = Model.Request.Status == LeaveRequestStatuses.Pending;
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
    <div>
        <h1 class="h3 mb-1">İzin Onayı</h1>
        <p class="text-secondary mb-0">@Model.Request.ConsultantName · @UiText.Date(Model.Request.StartDate) - @UiText.Date(Model.Request.EndDate)</p>
    </div>
    <a class="btn btn-outline-secondary" asp-action="Index">Geri</a>
</div>

@if (Model.Conflicts.Count > 0)
{
    <div class="alert alert-warning">
        Bu aralıkta @Model.Conflicts.Select(conflict => conflict.ConsultantId).Distinct().Count() danışmanın onaylı izni var.
    </div>
}

<div class="lf-panel">
    <dl class="row mb-0">
        <dt class="col-sm-3">Danışman</dt>
        <dd class="col-sm-9">@Model.Request.ConsultantName <span class="text-secondary">(@Model.Request.ConsultantEmail)</span></dd>
        <dt class="col-sm-3">Gerekçe</dt>
        <dd class="col-sm-9">@Model.Request.Reason</dd>
        <dt class="col-sm-3">Tarih aralığı</dt>
        <dd class="col-sm-9">@UiText.Date(Model.Request.StartDate) - @UiText.Date(Model.Request.EndDate)</dd>
        <dt class="col-sm-3">Takvim günü</dt>
        <dd class="col-sm-9">@Model.Request.CalendarDayCount</dd>
        <dt class="col-sm-3">Durum</dt>
        <dd class="col-sm-9"><span class="badge @LeaveFlow.Web.Controllers.LeaveRequestsController.StatusBadgeClass(Model.Request.Status)">@UiText.Status(Model.Request.Status)</span></dd>
        <dt class="col-sm-3">Oluşturulma</dt>
        <dd class="col-sm-9">@UiText.DateTime(Model.Request.CreatedAt)</dd>
        <dt class="col-sm-3">Değerlendirme</dt>
        <dd class="col-sm-9">@UiText.DateTime(Model.Request.ReviewedAt, "Henüz değerlendirilmedi")</dd>
        <dt class="col-sm-3">Değerlendirme notu</dt>
        <dd class="col-sm-9">@(Model.Request.ReviewNote ?? "-")</dd>
    </dl>
</div>

<div class="lf-panel mt-3">
    <h2 class="h5">Çakışma Önizlemesi</h2>
    @if (Model.TimelineRows.Count == 0)
    {
        <p class="text-secondary mb-0">Bu aralıkta onaylı izin çakışması yok.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-sm align-middle mb-0">
                <thead>
                    <tr>
                        <th>Danışman</th>
                        @foreach (var day in Model.PreviewDates)
                        {
                            <th class="text-center">@UiText.ShortMonthDay(day)</th>
                        }
                    </tr>
                </thead>
                <tbody>
                @foreach (var row in Model.TimelineRows)
                {
                    <tr>
                        <td>
                            <div>@row.ConsultantName</div>
                            <div class="text-secondary small">@row.ConsultantEmail</div>
                        </td>
                        @foreach (var day in Model.PreviewDates)
                        {
                            <td class="text-center">@(row.ConflictDates.Contains(day) ? "İzinde" : "-")</td>
                        }
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>

@if (isPending)
{
    <div class="lf-panel mt-3">
        <form asp-action="Approve" asp-route-id="@Model.Request.Id" method="post" class="mb-3">
            <label asp-for="Decision.ReviewNote" class="form-label">Değerlendirme notu</label>
            <textarea name="ReviewNote" class="form-control mb-2" rows="3"></textarea>
            <span asp-validation-for="Decision.ReviewNote" class="text-danger"></span>
            <button type="submit" class="btn btn-success" onclick="return confirm('Bu izin talebi onaylansın mı?');">Onayla</button>
        </form>
        <form asp-action="Reject" asp-route-id="@Model.Request.Id" method="post">
            <label class="form-label" for="rejectNote">Ret notu</label>
            <textarea id="rejectNote" name="ReviewNote" class="form-control mb-2" rows="3"></textarea>
            <button type="submit" class="btn btn-danger" onclick="return confirm('Bu izin talebi reddedilsin mi?');">Reddet</button>
        </form>
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
